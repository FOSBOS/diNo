<Application x:Class="diNo.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:diNo.Converters"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Resources/Icons.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <conv:NullableIntConverter x:Key="NullableIntConverter" />
      <!-- Notenpunkte-Bereich (0-15), für ConverterParameter des NullableIntConverter auf Notenfeldern -->
      <sys:String x:Key="Range0To15">0,15</sys:String>
    </ResourceDictionary>
  </Application.Resources>
</Application>
