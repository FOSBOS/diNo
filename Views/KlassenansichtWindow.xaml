<Window x:Class="diNo.Views.KlassenansichtWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        xmlns:views="clr-namespace:diNo.Views"
        Title="diNo" WindowState="Maximized" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </Window.Resources>

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Kopfbereich: Suche, Schülerinfo, Toolbar -->
    <Grid Grid.Row="0" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="252" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <StackPanel Orientation="Horizontal" Visibility="{Binding SiehtAlles, Converter={StaticResource BoolToVis}}">
          <StackPanel Width="194">
            <TextBlock Text="Schüler suchen" Margin="0,0,0,2" />
            <TextBox x:Name="SuchTextBox" Text="{Binding SuchText, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="SuchTextBox_KeyDown" />
          </StackPanel>
          <Button Width="41" Height="40" Margin="6,14,0,0" Command="{Binding SuchenCommand}" ToolTip="Suchen">
            <Image Source="{StaticResource IconLupe}" Width="20" Height="20" />
          </Button>
        </StackPanel>
        <TextBlock Text="nicht gefunden" Foreground="Red" Margin="0,2,0,0"
                    Visibility="{Binding SuchNichtGefunden, Converter={StaticResource BoolToVis}}" />
        <CheckBox Content="Abgemeldete Schüler ausblenden" IsChecked="{Binding NurAktive}" Margin="0,12,0,0" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
        <Image Source="{Binding BildQuelle}" Width="70" Height="70" />
        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding NameText}" FontSize="27" FontWeight="Bold" Foreground="#0000C0" />
          <TextBlock Text="{Binding KlasseText}" FontSize="16" />
        </StackPanel>
      </StackPanel>

      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="16,0,0,0">
        <Button x:Name="NotenabgebenButton" Width="40" Height="40" Command="{Binding NotenabgebenCommand}"
                ToolTip="Notendateien abgeben">
          <Image Source="{StaticResource IconExcel}" Width="24" Height="24" />
        </Button>
        <Button Width="40" Height="40" Margin="6,0,0,0" Command="{Binding LnwAbgebenCommand}"
                ToolTip="Angabe und Lösung von LNW abgeben">
          <Image Source="{StaticResource IconAblage}" Width="24" Height="24" />
        </Button>
        <Button x:Name="PrintButton" Width="40" Height="40" Margin="6,0,0,0" Click="PrintButton_Click"
                ToolTip="Notenbogen drucken">
          <Image Source="{StaticResource IconPrint}" Width="24" Height="24" />
          <Button.ContextMenu>
            <ContextMenu x:Name="PrintContextMenu" />
          </Button.ContextMenu>
        </Button>
        <Button Width="40" Height="40" Margin="6,0,0,0" Command="{Binding RefreshCommand}" ToolTip="Daten neu laden">
          <Image Source="{StaticResource IconRefresh}" Width="24" Height="24" />
        </Button>
        <Button Width="40" Height="40" Margin="6,0,0,0" Command="{Binding MailCommand}"
                ToolTip="Mail an alle betroffenen Lehrer">
          <Image Source="{StaticResource IconMail}" Width="24" Height="24" />
        </Button>
        <Button Width="40" Height="40" Margin="6,0,0,0" Command="{Binding BriefCommand}"
                IsEnabled="{Binding BriefEnabled}" ToolTip="Briefe für Nachtermine und Verweise erstellen">
          <Image Source="{StaticResource IconEdit}" Width="24" Height="24" />
        </Button>
        <Button Width="40" Height="40" Margin="6,0,0,0" Command="{Binding CheckCommand}"
                ToolTip="Notenbogen auf Vollständigkeit, Gefährdungen und Vorrücken prüfen">
          <Image Source="{StaticResource IconOk}" Width="24" Height="24" />
        </Button>
        <TextBlock Text="{Binding HinweiseText}" Foreground="Red" Margin="16,0,0,0" Width="260"
                   TextWrapping="Wrap" VerticalAlignment="Center" />
        <TextBlock Text="Testdatenbank" FontSize="24" Foreground="#C04000" Margin="16,0,0,0"
                   VerticalAlignment="Center" Visibility="{Binding IsTestDB, Converter={StaticResource BoolToVis}}" />
      </StackPanel>
    </Grid>

    <!-- Hauptbereich: Klassen-/Schülerbaum + Tabs -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="252" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <wfi:WindowsFormsHost x:Name="TreeHost" Grid.Column="0" />

      <TabControl Grid.Column="1" Margin="10,0,0,0">
        <TabItem Header="Schülerdaten">
          <views:SchueleransichtView x:Name="SchueleransichtView" />
        </TabItem>
        <TabItem Header="Notenbogen">
          <wfi:WindowsFormsHost x:Name="NotenbogenHost" />
        </TabItem>
        <TabItem Header="FPA / Seminar">
          <wfi:WindowsFormsHost x:Name="FPAundSeminarHost" />
        </TabItem>
        <TabItem Header="Vorkommnisse">
          <wfi:WindowsFormsHost x:Name="VorkommnisseHost" />
        </TabItem>
        <TabItem Header="Kurszuordnungen" Visibility="{Binding HatVerwaltungsrechte, Converter={StaticResource BoolToVis}}">
          <wfi:WindowsFormsHost x:Name="KurszuordnungenHost" />
        </TabItem>
        <TabItem Header="Sekretariat" Visibility="{Binding HatVerwaltungsrechte, Converter={StaticResource BoolToVis}}">
          <wfi:WindowsFormsHost x:Name="SekretariatHost" />
        </TabItem>
        <TabItem Header="Administration" Visibility="{Binding HatVerwaltungsrechte, Converter={StaticResource BoolToVis}}">
          <wfi:WindowsFormsHost x:Name="AdministrationHost" />
        </TabItem>
      </TabControl>
    </Grid>

    <!-- Statusleiste -->
    <StatusBar Grid.Row="2" Margin="0,8,0,0">
      <StatusBarItem>
        <TextBlock Text="{Binding StatusText}" />
      </StatusBarItem>
    </StatusBar>
  </Grid>
</Window>
