<Window x:Class="diNo.Views.KlassenansichtWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:diNo.Views"
        Title="diNo" WindowState="Maximized" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <Style x:Key="BaumZeile" TargetType="TextBlock">
      <Setter Property="Margin" Value="20,2,0,2" />
      <Setter Property="FontWeight" Value="Normal" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IstKlasse}" Value="True">
          <Setter Property="Margin" Value="0,2,0,2" />
          <Setter Property="FontWeight" Value="Bold" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Kopfbereich: Suche, Schülerinfo, Toolbar -->
    <Grid Grid.Row="0" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="252" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <StackPanel Orientation="Horizontal" Visibility="{Binding SiehtAlles, Converter={StaticResource BoolToVis}}">
          <StackPanel Width="194">
            <TextBlock Text="Schüler suchen" Margin="0,0,0,2" />
            <TextBox x:Name="SuchTextBox" Text="{Binding SuchText, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="SuchTextBox_KeyDown" />
          </StackPanel>
          <Button Width="41" Height="40" Margin="6,14,0,0" Command="{Binding SuchenCommand}" ToolTip="Suchen">
            <Image Source="{StaticResource IconLupe}" Width="20" Height="20" />
          </Button>
        </StackPanel>
        <TextBlock Text="nicht gefunden" Foreground="Red" Margin="0,2,0,0"
                    Visibility="{Binding SuchNichtGefunden, Converter={StaticResource BoolToVis}}" />
        <CheckBox Content="Abgemeldete Schüler ausblenden" IsChecked="{Binding NurAktive}" Margin="0,12,0,0" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
        <Image Source="{Binding BildQuelle}" Width="70" Height="70" />
        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding NameText}" FontSize="27" FontWeight="Bold" Foreground="#0000C0" />
          <TextBlock Text="{Binding KlasseText}" FontSize="16" />
        </StackPanel>
      </StackPanel>

      <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16,0,0,0">
        <Button x:Name="NotenabgebenButton" Width="40" Height="40" Command="{Binding NotenabgebenCommand}"
                ToolTip="Notendateien abgeben">
          <Image Source="{StaticResource IconExcel}" Width="36" Height="36" />
        </Button>
        <Button Width="40" Height="40" Margin="6,0,0,0" Command="{Binding LnwAbgebenCommand}"
                ToolTip="Angabe und Lösung von LNW abgeben">
          <Image Source="{StaticResource IconAblage}" Width="36" Height="36" />
        </Button>
        <Button x:Name="PrintButton" Width="40" Height="40" Margin="6,0,0,0" Click="PrintButton_Click"
                ToolTip="Notenbogen drucken">
          <Image Source="{StaticResource IconPrint}" Width="36" Height="36" />
          <Button.ContextMenu>
            <ContextMenu x:Name="PrintContextMenu" />
          </Button.ContextMenu>
        </Button>
        <Button Width="40" Height="40" Margin="6,0,0,0" Command="{Binding RefreshCommand}" ToolTip="Daten neu laden">
          <Image Source="{StaticResource IconRefresh}" Width="36" Height="36" />
        </Button>
        <Button Width="40" Height="40" Margin="6,0,0,0" Command="{Binding MailCommand}"
                ToolTip="Mail an alle betroffenen Lehrer">
          <Image Source="{StaticResource IconMail}" Width="36" Height="36" />
        </Button>
        <Button Width="40" Height="40" Margin="6,0,0,0" Command="{Binding BriefCommand}"
                IsEnabled="{Binding BriefEnabled}" ToolTip="Briefe für Nachtermine und Verweise erstellen">
          <Image Source="{StaticResource IconEdit}" Width="36" Height="36" />
        </Button>
        <Button Width="40" Height="40" Margin="6,0,0,0" Command="{Binding CheckCommand}"
                ToolTip="Notenbogen auf Vollständigkeit, Gefährdungen und Vorrücken prüfen">
          <Image Source="{StaticResource IconOk}" Width="36" Height="36" />
        </Button>
        <TextBlock Text="{Binding HinweiseText}" Foreground="Red" Margin="16,0,0,0" Width="260"
                   TextWrapping="Wrap" VerticalAlignment="Center" />
        <TextBlock Text="Testdatenbank" FontSize="24" Foreground="#C04000" Margin="16,0,0,0"
                   VerticalAlignment="Center" Visibility="{Binding IsTestDB, Converter={StaticResource BoolToVis}}" />
      </StackPanel>
    </Grid>

    <!-- Hauptbereich: Klassen-/Schülerbaum + Tabs -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="252" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <ListBox x:Name="BaumListBox" Grid.Column="0" ItemsSource="{Binding Rows}" SelectionMode="Extended" AllowDrop="True"
               SelectionChanged="BaumListBox_SelectionChanged"
               PreviewMouseLeftButtonDown="BaumListBox_PreviewMouseLeftButtonDown"
               PreviewMouseMove="BaumListBox_PreviewMouseMove"
               DragOver="BaumListBox_DragOver" Drop="BaumListBox_Drop">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal">
              <Button Width="16" Height="16" Padding="0" BorderThickness="0" Background="Transparent"
                      Visibility="{Binding IstKlasse, Converter={StaticResource BoolToVis}}"
                      Command="{Binding ToggleCommand}" Content="{Binding ExpandGlyph}" FontSize="10" />
              <TextBlock Text="{Binding Bezeichnung}" Style="{StaticResource BaumZeile}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <TabControl Grid.Column="1" Margin="10,0,0,0">
        <TabItem>
          <TabItem.Header>
            <TextBlock Text="Schülerdaten" FontSize="15" />
          </TabItem.Header>
          <views:SchueleransichtView x:Name="SchueleransichtView" />
        </TabItem>
        <TabItem>
          <TabItem.Header>
            <TextBlock Text="Notenbogen" FontSize="15" />
          </TabItem.Header>
          <views:NotenbogenView x:Name="NotenbogenView" />
        </TabItem>
        <TabItem>
          <TabItem.Header>
            <TextBlock Text="FPA / Seminar" FontSize="15" />
          </TabItem.Header>
          <views:FPAundSeminarView x:Name="FPAundSeminarView" />
        </TabItem>
        <TabItem>
          <TabItem.Header>
            <TextBlock Text="Vorkommnisse" FontSize="15" />
          </TabItem.Header>
          <views:VorkommnisseView x:Name="VorkommnisseView" />
        </TabItem>
        <TabItem Visibility="{Binding HatVerwaltungsrechte, Converter={StaticResource BoolToVis}}">
          <TabItem.Header>
            <TextBlock Text="Kurszuordnungen" FontSize="15" />
          </TabItem.Header>
          <views:KurszuordnungenView x:Name="KurszuordnungenView" />
        </TabItem>
        <TabItem Visibility="{Binding HatVerwaltungsrechte, Converter={StaticResource BoolToVis}}">
          <TabItem.Header>
            <TextBlock Text="Sekretariat" FontSize="15" />
          </TabItem.Header>
          <views:SekretariatView x:Name="SekretariatView" />
        </TabItem>
        <TabItem Visibility="{Binding HatVerwaltungsrechte, Converter={StaticResource BoolToVis}}">
          <TabItem.Header>
            <TextBlock Text="Administration" FontSize="15" />
          </TabItem.Header>
          <views:AdministrationView x:Name="AdministrationView" />
        </TabItem>
      </TabControl>
    </Grid>

    <!-- Statusleiste -->
    <StatusBar Grid.Row="2" Margin="0,8,0,0">
      <StatusBarItem>
        <TextBlock Text="{Binding StatusText}" />
      </StatusBarItem>
    </StatusBar>
  </Grid>
</Window>
