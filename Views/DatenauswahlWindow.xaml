<Window x:Class="diNo.Views.DatenauswahlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Datenauswahl" Height="228" Width="362"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" ShowInTaskbar="False">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ComboBox x:Name="AuswahlComboBox" Grid.Row="0" FontSize="14"
              ItemsSource="{Binding AuswahlOptions}"
              SelectedIndex="{Binding SelectedAuswahlIndex}"
              Margin="0,0,0,8" />

    <ComboBox Grid.Row="1" FontSize="14"
              ItemsSource="{Binding VorkommnisOptions}"
              DisplayMemberPath="Value" SelectedValuePath="Key"
              SelectedValue="{Binding SelectedVorkommnisart}"
              IsEnabled="{Binding IsVorkommnisEnabled}"
              Margin="0,0,0,8" />

    <ComboBox Grid.Row="2" FontSize="14"
              ItemsSource="{Binding ZubringerschuleOptions}"
              Text="{Binding ZubringerschuleText, UpdateSourceTrigger=PropertyChanged}"
              IsEditable="True"
              IsEnabled="{Binding IsZubringerschuleEnabled}" />

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,16,0,0">
      <Button Content="OK" Width="159" Height="40" FontWeight="Bold" IsDefault="True"
              Command="{Binding OkCommand}" />
      <Button Content="Abbrechen" Width="149" Height="40" Margin="10,0,0,0" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
