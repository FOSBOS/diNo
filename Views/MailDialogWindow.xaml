<Window x:Class="diNo.Views.MailDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mail versenden" Height="520" Width="780"
        WindowStartupLocation="CenterScreen" FontSize="14">
  <Grid Margin="12">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="320" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <StackPanel Grid.Column="0">
      <TextBlock Text="{Binding AnzahlText}" FontSize="14" Margin="0,0,0,8" />

      <CheckBox Content="Test (ein Mail an angemeldeten User)" IsChecked="{Binding IsTest}" Margin="0,0,0,12" />

      <GroupBox Header="Mail geht an" Padding="8">
        <StackPanel>
          <RadioButton GroupName="Empfaenger" Content="schulische Mailadresse" IsChecked="{Binding IsToSchueler}" Margin="0,0,0,6" />
          <RadioButton GroupName="Empfaenger" Content="Eltern" IsChecked="{Binding IsToEltern}" />
        </StackPanel>
      </GroupBox>

      <GroupBox Header="Antwortadresse" Padding="8" Margin="0,10,0,0">
        <StackPanel>
          <RadioButton GroupName="Reply" Content="diNo" IsChecked="{Binding IsReplyDino}" Margin="0,0,0,6" />
          <RadioButton GroupName="Reply" Content="Sekretariat" IsChecked="{Binding IsReplySekretariat}" Margin="0,0,0,6" />
          <RadioButton GroupName="Reply" Content="Klassenleiter" IsChecked="{Binding IsReplyKL}" />
        </StackPanel>
      </GroupBox>

      <GroupBox Header="Anhang" Padding="8" Margin="0,10,0,0">
        <StackPanel>
          <RadioButton GroupName="Anhang" Content="keiner" IsChecked="{Binding IsAnhangKeiner}" Margin="0,0,0,6" />
          <RadioButton GroupName="Anhang" Content="Notenübersicht" IsChecked="{Binding IsAnhangNoten}" Margin="0,0,0,6" />
          <RadioButton GroupName="Anhang" Content="PDF (gleich für alle Empfänger)" IsChecked="{Binding IsAnhangPDF}" Margin="0,0,0,6" />
          <RadioButton GroupName="Anhang" Content="Absenzenübersicht (kein Bodytext nötig)" IsChecked="{Binding IsAnhangAbsenzen}" />
        </StackPanel>
      </GroupBox>

      <CheckBox Content="Anhang zippen und verschlüsseln (Pw=FB-jjjjmmtt)" IsChecked="{Binding IsZip}" Margin="0,14,0,0" />
    </StackPanel>

    <Grid Grid.Column="1" Margin="16,0,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Label Grid.Row="0" Content="Betreff" />
      <TextBox Grid.Row="1" Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

      <Label Grid.Row="2" Content="Bodytext (Anrede automatisch)" />
      <TextBox Grid.Row="3" Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}"
               AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8" />

      <CheckBox Grid.Row="4" Content="Bodytext aus txt-Datei lesen" IsChecked="{Binding IsReadBodyText}" Margin="0,0,0,12" />

      <Button Grid.Row="5" Content="Versenden" Height="39" Command="{Binding SendCommand}" IsEnabled="{Binding CanSend}" />

      <TextBlock Grid.Row="6" Text="Fehlerausgabe unter Downloads" Margin="0,10,0,0" />
    </Grid>
  </Grid>
</Window>
