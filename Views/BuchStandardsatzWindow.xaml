<Window x:Class="diNo.Views.BuchStandardsatzWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Standardsätze (Bibliothek)" Height="620" Width="760"
        WindowStartupLocation="CenterScreen" FontSize="14">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="Neue Standardbuchung anlegen (gilt für alle Schüler der gewählten Konstellation):"
               TextWrapping="Wrap" Margin="0,0,0,10" />

    <Grid Grid.Row="1" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="130" />
        <ColumnDefinition Width="150" />
        <ColumnDefinition Width="150" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Margin="0,0,8,0">
        <Label Content="Jahrgangsstufe" Padding="0,0,0,2" />
        <ComboBox ItemsSource="{Binding JahrgangsstufenOptions}" SelectedItem="{Binding Jahrgangsstufe}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Margin="0,0,8,0">
        <Label Content="Schulart" Padding="0,0,0,2" />
        <ComboBox ItemsSource="{Binding SchulartOptions}" DisplayMemberPath="Value" SelectedValuePath="Key"
                  SelectedValue="{Binding SchulartAuswahl}" />
      </StackPanel>
      <StackPanel Grid.Column="2" Margin="0,0,8,0">
        <Label Content="Zweig" Padding="0,0,0,2" />
        <ComboBox ItemsSource="{Binding ZweigOptions}" DisplayMemberPath="Value" SelectedValuePath="Key"
                  SelectedValue="{Binding ZweigAuswahl}" />
      </StackPanel>
      <StackPanel Grid.Column="3">
        <Label Content="Buch" Padding="0,0,0,2" />
        <ComboBox ItemsSource="{Binding BuchOptions}" DisplayMemberPath="Anzeige" SelectedItem="{Binding SelectedBuch}" />
      </StackPanel>
    </Grid>

    <Button Grid.Row="2" Width="140" Height="32" HorizontalAlignment="Left" Margin="0,0,0,16"
            Command="{Binding AddCommand}" Content="Hinzufügen" />

    <DataGrid Grid.Row="3" ItemsSource="{Binding Eintraege}" AutoGenerateColumns="False"
              IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionUnit="FullRow">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Jahrgangsstufe" Binding="{Binding JahrgangsstufeText}" Width="110" />
        <DataGridTextColumn Header="Schulart" Binding="{Binding SchulartText}" Width="100" />
        <DataGridTextColumn Header="Zweig" Binding="{Binding ZweigText}" Width="100" />
        <DataGridTextColumn Header="Buch" Binding="{Binding BuchText}" Width="*" />
        <DataGridTemplateColumn Width="30">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Button Width="22" Height="22" Padding="0" ToolTip="Löschen"
                      Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                      CommandParameter="{Binding}">
                <Image Source="{StaticResource IconMuell}" Width="16" Height="16" />
              </Button>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</Window>
