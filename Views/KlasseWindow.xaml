<Window x:Class="diNo.Views.KlasseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Klassen" Height="580" Width="530"
        WindowStartupLocation="CenterScreen" FontSize="14">
  <Grid Margin="16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="200" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ListBox Grid.Row="0" Grid.Column="0" ItemsSource="{Binding Klassen}" DisplayMemberPath="Bezeichnung"
              SelectedItem="{Binding SelectedKlasse}" />

    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,10,0,0">
      <Button Width="40" Height="40" Command="{Binding AddCommand}" IsEnabled="False">
        <Image Source="{StaticResource IconPlus}" Width="20" Height="20" />
      </Button>
      <Button Width="40" Height="40" Margin="10,0,0,0" Command="{Binding DeleteCommand}">
        <Image Source="{StaticResource IconMinus}" Width="20" Height="20" />
      </Button>
    </StackPanel>

    <Grid Grid.Row="0" Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Top">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Label Grid.Row="0" Content="Bezeichnung" />
      <TextBox Grid.Row="1" Text="{Binding Bezeichnung, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

      <Label Grid.Row="2" Content="Jahrgangsstufe" />
      <TextBox Grid.Row="3" Text="{Binding JgStufe, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

      <Label Grid.Row="4" Content="Schulart" />
      <ComboBox Grid.Row="5" ItemsSource="{Binding SchulartOptions}" SelectedIndex="{Binding SchulartIndex}" Margin="0,0,0,10" />

      <Label Grid.Row="6" Content="Zweig" />
      <TextBox Grid.Row="7" Text="{Binding Zweig, UpdateSourceTrigger=PropertyChanged}" />
    </Grid>

    <Grid Grid.Row="0" Grid.Column="1" Margin="24,220,0,0" VerticalAlignment="Top">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Label Grid.Row="0" Content="Klassenleiter" />
      <ComboBox Grid.Row="1" ItemsSource="{Binding AlleLehrer}" DisplayMemberPath="KompletterName" SelectedValuePath="Id"
                SelectedValue="{Binding KlassenleiterId}" />
    </Grid>

    <Button Grid.Row="1" Grid.Column="1" Width="40" Height="40" HorizontalAlignment="Left" Margin="0,10,0,0"
            Command="{Binding SaveCommand}">
      <Image Source="{StaticResource IconSave}" Width="24" Height="24" />
    </Button>
  </Grid>
</Window>
