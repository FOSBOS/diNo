<Window x:Class="diNo.Views.BriefWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Verweis" Height="560" Width="720"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        ShowInTaskbar="False" Visibility="Hidden" FontSize="14">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <GroupBox Grid.Column="0" VerticalAlignment="Top">
        <StackPanel>
          <RadioButton GroupName="BriefTyp" Content="Nachtermin SA" IsChecked="{Binding OpSA}" Margin="0,4" />
          <RadioButton GroupName="BriefTyp" Content="Nachtermin KA" IsChecked="{Binding OpKA}" Margin="0,4" />
          <RadioButton GroupName="BriefTyp" Content="schriftl. Ersatzprüfung" IsChecked="{Binding OpSEP}" Margin="0,4" />
          <RadioButton GroupName="BriefTyp" Content="mdl. Ersatzprüfung" IsChecked="{Binding OpMEP}" Margin="0,4" />
          <RadioButton GroupName="BriefTyp" Content="Verweis" IsChecked="{Binding OpVerweis}" Margin="0,4" />
          <RadioButton GroupName="BriefTyp" Content="Nacharbeit" IsChecked="{Binding OpNacharbeit}" Margin="0,4" />
          <RadioButton GroupName="BriefTyp" Content="verschärfter Verweis" IsChecked="{Binding OpVerschVerweis}" Margin="0,4" />
          <RadioButton GroupName="BriefTyp" Content="Attestpflicht" IsChecked="{Binding OpAttestpflicht}" IsEnabled="{Binding IsAttestpflichtEnabled}" Margin="0,4" />
          <RadioButton GroupName="BriefTyp" Content="Mitteilung an Eltern" IsChecked="{Binding OpMitteilung}" Margin="0,4" />
        </StackPanel>
      </GroupBox>

      <StackPanel Grid.Column="1" Margin="20,0,0,0">
        <Border IsEnabled="{Binding IsVersaeumtAmEnabled}" Padding="0,0,0,10">
          <StackPanel>
            <TextBlock Text="Es wurde der Leistungsnachweis versäumt vom" />
            <DatePicker SelectedDate="{Binding VersaeumtAm}" Width="298" HorizontalAlignment="Left" Margin="0,4,0,0" />
          </StackPanel>
        </Border>

        <Border IsEnabled="{Binding IsNachterminAmEnabled}" Padding="0,10,0,10">
          <StackPanel>
            <TextBlock Text="Der Nachtermin / Nacharbeit findet statt am" />
            <Grid Margin="0,4,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="298" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="86" />
              </Grid.ColumnDefinitions>
              <DatePicker Grid.Column="0" SelectedDate="{Binding Termin}" />
              <StackPanel Grid.Column="2">
                <TextBlock Text="um" />
                <TextBox Text="{Binding ZeitText, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0" />
              </StackPanel>
            </Grid>
            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="298" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="86" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="im Fach" />
                <ComboBox ItemsSource="{Binding FachOptions}" SelectedItem="{Binding SelectedFach}" Margin="0,2,0,0" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Raum (optional)" />
                <TextBox Text="{Binding Raum, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <Border IsEnabled="{Binding IsInhaltEnabled}" Margin="0,20,0,0">
          <StackPanel>
            <TextBlock Text="{Binding InhaltLabel}" />
            <TextBox Text="{Binding Inhalt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                     Height="120" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="OK" Width="123" Height="38" IsDefault="True" Command="{Binding OkCommand}" />
      <Button Content="Abbrechen" Width="123" Height="38" Margin="10,0,0,0" Command="{Binding EscCommand}" />
    </StackPanel>
  </Grid>
</Window>
