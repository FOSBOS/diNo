<UserControl x:Class="diNo.Views.SchueleransichtView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontSize="14">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <Style TargetType="TextBlock" x:Key="FeldLabel">
      <Setter Property="Margin" Value="0,6,0,2" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Margin" Value="0,0,0,0" />
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280" />
        <ColumnDefinition Width="32" />
        <ColumnDefinition Width="280" />
      </Grid.ColumnDefinitions>

      <!-- Adresse und Kontakt -->
      <StackPanel Grid.Column="0">
        <TextBlock Text="Straße" Style="{StaticResource FeldLabel}" />
        <TextBox Text="{Binding Strasse, UpdateSourceTrigger=PropertyChanged}" />

        <Grid Margin="0,6,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="PLZ" Style="{StaticResource FeldLabel}" Margin="0,0,0,2" />
            <TextBox Text="{Binding Plz, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Ort" Style="{StaticResource FeldLabel}" Margin="0,0,0,2" />
            <TextBox Text="{Binding Ort, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
        </Grid>

        <TextBlock Text="Telefonnummer" Style="{StaticResource FeldLabel}" />
        <TextBox Text="{Binding Telefonnummer, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="Mail" Style="{StaticResource FeldLabel}" />
        <TextBox Text="{Binding EigeneMail, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="Schulische Mailadresse" Style="{StaticResource FeldLabel}" />
        <TextBox Text="{Binding MailSchule, UpdateSourceTrigger=PropertyChanged}" />

        <Grid Margin="0,6,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="geboren am" Style="{StaticResource FeldLabel}" Margin="0,0,0,2" />
            <TextBox Text="{Binding Geburtsdatum}" IsEnabled="False" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Geburtsort" Style="{StaticResource FeldLabel}" Margin="0,0,0,2" />
            <TextBox Text="{Binding Geburtsort, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
        </Grid>

        <TextBlock Text="Kontakt Eltern" Style="{StaticResource FeldLabel}" />
        <TextBox Text="{Binding AdresseEltern}" IsEnabled="False" IsReadOnly="True" Height="46" TextWrapping="Wrap" AcceptsReturn="True" />

        <TextBlock Text="Mailadresse der Eltern" Style="{StaticResource FeldLabel}" />
        <TextBox Text="{Binding MailEltern}" IsEnabled="False" />
      </StackPanel>

      <!-- Schule, Status, Termine -->
      <StackPanel Grid.Column="2">
        <TextBlock Text="Status des Schülers" Style="{StaticResource FeldLabel}" />
        <ComboBox SelectedIndex="{Binding StatusIndex}">
          <ComboBoxItem Content="Aktiv" />
          <ComboBoxItem Content="Abgemeldet" />
        </ComboBox>

        <Grid Margin="0,6,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="Eintritt am" Style="{StaticResource FeldLabel}" Margin="0,0,0,2" />
            <TextBox Text="{Binding EintrittAm}" IsEnabled="False" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="in Jahrgangsstufe" Style="{StaticResource FeldLabel}" Margin="0,0,0,2" />
            <TextBox Text="{Binding Jahrgangsstufe}" IsEnabled="False" />
          </StackPanel>
        </Grid>

        <Grid Margin="0,6,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="Probezeit bis" Style="{StaticResource FeldLabel}" Margin="0,0,0,2" />
            <DockPanel>
              <Button DockPanel.Dock="Right" Width="20" Height="20" Command="{Binding ResetProbezeitCommand}"
                      Visibility="{Binding HatVerwaltungsrechte, Converter={StaticResource BoolToVis}}"
                      ToolTip="Probezeit zurücksetzen">
                <Image Source="{StaticResource IconMuell}" />
              </Button>
              <DatePicker SelectedDate="{Binding ProbezeitBis}" />
            </DockPanel>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Austritt am" Style="{StaticResource FeldLabel}" Margin="0,0,0,2" />
            <DatePicker SelectedDate="{Binding Austrittsdatum}" />
            <TextBlock Text="Bei Austritt erst Status ändern!" Foreground="Gray" FontSize="11" Margin="0,2,0,0"
                       Visibility="{Binding HatVerwaltungsrechte, Converter={StaticResource BoolToVis}}" />
          </StackPanel>
        </Grid>

        <TextBlock Text="Bekenntnis" Style="{StaticResource FeldLabel}" />
        <TextBox Text="{Binding Bekenntnis, UpdateSourceTrigger=PropertyChanged}" Width="90" HorizontalAlignment="Left" />

        <TextBlock Text="vorige Schule" Style="{StaticResource FeldLabel}" />
        <TextBox IsEnabled="False" Height="46" />

        <TextBlock Text="berufliche Vorbildung" Style="{StaticResource FeldLabel}" />
        <TextBox IsEnabled="False" />

        <TextBlock Text="Wiederholungen" Style="{StaticResource FeldLabel}" />
        <TextBox Text="{Binding Wiederholungen}" IsEnabled="False" />

        <Button Width="40" Height="40" HorizontalAlignment="Left" Margin="0,16,0,0"
                Command="{Binding SaveCommand}" ToolTip="Speichern"
                Visibility="{Binding HatVerwaltungsrechte, Converter={StaticResource BoolToVis}}">
          <Image Source="{StaticResource IconSave}" Width="24" Height="24" />
        </Button>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
