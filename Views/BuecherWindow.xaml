<Window x:Class="diNo.Views.BuecherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bücher (Stammdaten)" Height="600" Width="560"
        WindowStartupLocation="CenterScreen" FontSize="14">
  <Grid Margin="16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ListBox Grid.Row="0" Grid.Column="0" ItemsSource="{Binding BuchListe}" DisplayMemberPath="Anzeige"
             SelectedItem="{Binding SelectedBuch}" />
    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,10,0,0">
      <Button Width="40" Height="40" Command="{Binding AddCommand}" ToolTip="Neues Buch">
        <Image Source="{StaticResource IconPlus}" Width="20" Height="20" />
      </Button>
      <Button Width="40" Height="40" Margin="10,0,0,0" Command="{Binding DeleteCommand}" ToolTip="Buch löschen">
        <Image Source="{StaticResource IconMinus}" Width="20" Height="20" />
      </Button>
    </StackPanel>

    <StackPanel Grid.Row="0" Grid.Column="1" Margin="20,0,0,0">
      <Label Content="Titel" />
      <TextBox Text="{Binding Titel, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

      <Grid Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="10" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <Label Content="Fachkürzel" />
          <TextBox Text="{Binding Fach, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <Label Content="ISBN" />
          <TextBox Text="{Binding IsbnText, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
      </Grid>

      <Label Content="Autor" />
      <TextBox Text="{Binding Autor, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

      <Label Content="Verlag" />
      <TextBox Text="{Binding Verlag, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

      <Grid Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="10" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <Label Content="Preis (€)" />
          <TextBox Text="{Binding PreisText, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <Label Content="Bestand (Exemplare)" />
          <TextBox Text="{Binding BestandText, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
      </Grid>

      <CheckBox Content="Aktiv (erscheint in Auswahllisten/Standardsätzen)" IsChecked="{Binding Aktiv}" Margin="0,0,0,10" />
    </StackPanel>

    <Button Grid.Row="1" Grid.Column="1" Width="40" Height="40" HorizontalAlignment="Left" Margin="0,10,0,0"
            Command="{Binding SaveCommand}" ToolTip="Speichern">
      <Image Source="{StaticResource IconSave}" Width="24" Height="24" />
    </Button>
  </Grid>
</Window>
