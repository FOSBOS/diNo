<UserControl x:Class="diNo.Views.FPAundSeminarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontSize="14">
  <UserControl.Resources>
    <Style TargetType="TextBlock" x:Key="FeldLabel">
      <Setter Property="Margin" Value="0,6,0,2" />
    </Style>
    <Style TargetType="TextBox" x:Key="Zahlenfeld">
      <Setter Property="Width" Value="50" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="TextAlignment" Value="Right" />
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="16">
      <TextBlock Text="Fachpraktische Ausbildung" FontSize="18" Margin="0,0,0,10" />

      <Grid IsEnabled="{Binding FpaEnabled}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="280" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="280" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="140" />
        </Grid.ColumnDefinitions>

        <GroupBox Grid.Column="0" Header="1. Halbjahr">
          <StackPanel Margin="4">
            <TextBlock Text="Betrieb (50%)" Style="{StaticResource FeldLabel}" />
            <TextBox Style="{StaticResource Zahlenfeld}" Text="{Binding Betrieb1, Converter={StaticResource NullableIntConverter}, ConverterParameter={StaticResource Range0To15}}" />
            <TextBlock Text="Anleitung (25%)" Style="{StaticResource FeldLabel}" />
            <TextBox Style="{StaticResource Zahlenfeld}" Text="{Binding Anleitung1, Converter={StaticResource NullableIntConverter}, ConverterParameter={StaticResource Range0To15}}" />
            <TextBlock Text="{Binding Vertiefung1Label}" Style="{StaticResource FeldLabel}" IsEnabled="{Binding IstVertiefung12}" />
            <TextBox Style="{StaticResource Zahlenfeld}" IsEnabled="{Binding IstVertiefung12}"
                     Text="{Binding Vertiefung11, Converter={StaticResource NullableIntConverter}, ConverterParameter={StaticResource Range0To15}}" />
            <TextBlock Text="{Binding Vertiefung2Label}" Style="{StaticResource FeldLabel}" IsEnabled="{Binding IstVertiefung12}" />
            <TextBox Style="{StaticResource Zahlenfeld}" IsEnabled="{Binding IstVertiefung12}"
                     Text="{Binding Vertiefung21, Converter={StaticResource NullableIntConverter}, ConverterParameter={StaticResource Range0To15}}" />
            <TextBlock Text="{Binding VertiefungLabel}">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource FeldLabel}">
                  <Setter Property="IsEnabled" Value="True" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IstVertiefung12}" Value="True">
                      <Setter Property="IsEnabled" Value="False" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBox Text="{Binding Vertiefung1, Converter={StaticResource NullableIntConverter}, ConverterParameter={StaticResource Range0To15}}">
              <TextBox.Style>
                <Style TargetType="TextBox" BasedOn="{StaticResource Zahlenfeld}">
                  <Setter Property="IsEnabled" Value="True" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IstVertiefung12}" Value="True">
                      <Setter Property="IsEnabled" Value="False" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBox.Style>
            </TextBox>
            <TextBlock Text="Gesamtpunktzahl" Style="{StaticResource FeldLabel}" />
            <TextBox Style="{StaticResource Zahlenfeld}" IsEnabled="False"
                     Text="{Binding Gesamt1, Converter={StaticResource NullableIntConverter}, ConverterParameter={StaticResource Range0To15}}" />
            <TextBlock Text="Stelle" Style="{StaticResource FeldLabel}" />
            <TextBox Text="{Binding Stelle1, UpdateSourceTrigger=PropertyChanged}" Height="38" TextWrapping="Wrap" AcceptsReturn="True" />
            <TextBlock Text="Bemerkung" Style="{StaticResource FeldLabel}" />
            <TextBox Text="{Binding Bemerkung1, UpdateSourceTrigger=PropertyChanged}" Height="38" TextWrapping="Wrap" AcceptsReturn="True" />
          </StackPanel>
        </GroupBox>

        <GroupBox Grid.Column="2" Header="2. Halbjahr">
          <StackPanel Margin="4">
            <TextBlock Text="Betrieb (50%)" Style="{StaticResource FeldLabel}" />
            <TextBox Style="{StaticResource Zahlenfeld}" Text="{Binding Betrieb2, Converter={StaticResource NullableIntConverter}, ConverterParameter={StaticResource Range0To15}}" />
            <TextBlock Text="Anleitung (25%)" Style="{StaticResource FeldLabel}" />
            <TextBox Style="{StaticResource Zahlenfeld}" Text="{Binding Anleitung2, Converter={StaticResource NullableIntConverter}, ConverterParameter={StaticResource Range0To15}}" />
            <TextBlock Text="{Binding Vertiefung1Label}" Style="{StaticResource FeldLabel}" IsEnabled="{Binding IstVertiefung12}" />
            <TextBox Style="{StaticResource Zahlenfeld}" IsEnabled="{Binding IstVertiefung12}"
                     Text="{Binding Vertiefung12, Converter={StaticResource NullableIntConverter}, ConverterParameter={StaticResource Range0To15}}" />
            <TextBlock Text="{Binding Vertiefung2Label}" Style="{StaticResource FeldLabel}" IsEnabled="{Binding IstVertiefung12}" />
            <TextBox Style="{StaticResource Zahlenfeld}" IsEnabled="{Binding IstVertiefung12}"
                     Text="{Binding Vertiefung22, Converter={StaticResource NullableIntConverter}, ConverterParameter={StaticResource Range0To15}}" />
            <TextBlock Text="{Binding VertiefungLabel}">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource FeldLabel}">
                  <Setter Property="IsEnabled" Value="True" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IstVertiefung12}" Value="True">
                      <Setter Property="IsEnabled" Value="False" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBox Text="{Binding Vertiefung2, Converter={StaticResource NullableIntConverter}, ConverterParameter={StaticResource Range0To15}}">
              <TextBox.Style>
                <Style TargetType="TextBox" BasedOn="{StaticResource Zahlenfeld}">
                  <Setter Property="IsEnabled" Value="True" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IstVertiefung12}" Value="True">
                      <Setter Property="IsEnabled" Value="False" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBox.Style>
            </TextBox>
            <TextBlock Text="Gesamtpunktzahl" Style="{StaticResource FeldLabel}" />
            <TextBox Style="{StaticResource Zahlenfeld}" IsEnabled="False"
                     Text="{Binding Gesamt2, Converter={StaticResource NullableIntConverter}, ConverterParameter={StaticResource Range0To15}}" />
            <TextBlock Text="Stelle" Style="{StaticResource FeldLabel}" />
            <TextBox Text="{Binding Stelle2, UpdateSourceTrigger=PropertyChanged}" Height="38" TextWrapping="Wrap" AcceptsReturn="True" />
            <TextBlock Text="Bemerkung" Style="{StaticResource FeldLabel}" />
            <TextBox Text="{Binding Bemerkung2, UpdateSourceTrigger=PropertyChanged}" Height="38" TextWrapping="Wrap" AcceptsReturn="True" />
          </StackPanel>
        </GroupBox>

        <GroupBox Grid.Column="4" Header="Gesamt">
          <StackPanel Margin="4">
            <TextBlock Text="Jahrespunkte" Style="{StaticResource FeldLabel}" />
            <TextBox Style="{StaticResource Zahlenfeld}" IsEnabled="False"
                     Text="{Binding Jahrespunkte, Converter={StaticResource NullableIntConverter}, ConverterParameter={StaticResource Range0To15}}" />
            <Button Width="40" Height="40" HorizontalAlignment="Left" Margin="0,16,0,0"
                    Command="{Binding SaveFPACommand}" ToolTip="Speichern">
              <Image Source="{StaticResource IconSave}" Width="24" Height="24" />
            </Button>
          </StackPanel>
        </GroupBox>
      </Grid>

      <GroupBox Header="Seminararbeit" Margin="0,16,0,0" HorizontalAlignment="Left" IsEnabled="{Binding SeminarEnabled}">
        <StackPanel Margin="4" Width="460">
          <TextBlock Text="Notenpunkte" Style="{StaticResource FeldLabel}" />
          <StackPanel Orientation="Horizontal">
            <TextBox Style="{StaticResource Zahlenfeld}" Width="60"
                     Text="{Binding Seminarpunkte, Converter={StaticResource NullableIntConverter}, ConverterParameter={StaticResource Range0To15}}" />
            <Button Width="40" Height="40" Margin="16,0,0,0" Command="{Binding SaveSeminarCommand}" ToolTip="Speichern">
              <Image Source="{StaticResource IconSave}" Width="24" Height="24" />
            </Button>
          </StackPanel>
          <TextBlock Text="Thema" Style="{StaticResource FeldLabel}" />
          <TextBox Text="{Binding SeminarThema, UpdateSourceTrigger=PropertyChanged}" Height="63" TextWrapping="Wrap" AcceptsReturn="True" />
        </StackPanel>
      </GroupBox>
    </StackPanel>
  </ScrollViewer>
</UserControl>
