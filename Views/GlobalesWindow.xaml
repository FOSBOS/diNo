<Window x:Class="diNo.Views.GlobalesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Globale Texte" Height="380" Width="620"
        WindowStartupLocation="CenterScreen" FontSize="14">
  <Grid Margin="16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="200" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="56" />
    </Grid.ColumnDefinitions>

    <ListBox Grid.Column="0" ItemsSource="{Binding Rows}" DisplayMemberPath="Bezeichnung"
              SelectedItem="{Binding SelectedRow}" />

    <Grid Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Top">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Label Grid.Row="0" Content="Bezeichnung" />
      <TextBox Grid.Row="1" Text="{Binding Bezeichnung}" IsEnabled="False" Margin="0,0,0,12" />
      <Label Grid.Row="2" Content="Wert" />
      <TextBox Grid.Row="3" Text="{Binding Wert, UpdateSourceTrigger=PropertyChanged}" />
    </Grid>

    <Button Grid.Column="2" Width="40" Height="40" VerticalAlignment="Top" Margin="0,38,0,0"
            Command="{Binding SaveCommand}">
      <Image Source="{StaticResource IconSave}" Width="24" Height="24" />
    </Button>
  </Grid>
</Window>
