<Window x:Class="diNo.Views.LehrerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lehrer" Height="600" Width="560"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="200" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ListBox Grid.Row="0" Grid.Column="0" ItemsSource="{Binding Lehrer}" DisplayMemberPath="KompletterName"
             SelectedItem="{Binding SelectedLehrer}" />
    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,10,0,0">
      <Button Width="40" Height="40" Command="{Binding AddCommand}">
        <Image Source="{StaticResource IconPlus}" Width="20" Height="20" />
      </Button>
      <Button Width="40" Height="40" Margin="10,0,0,0" Command="{Binding DeleteCommand}">
        <Image Source="{StaticResource IconMinus}" Width="20" Height="20" />
      </Button>
    </StackPanel>

    <StackPanel Grid.Row="0" Grid.Column="1" Margin="20,0,0,0">
      <Label Content="Nachname" />
      <TextBox Text="{Binding Nachname, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

      <Label Content="Vorname" />
      <TextBox x:Name="VornameTextBox" Text="{Binding Vorname, UpdateSourceTrigger=PropertyChanged}"
               LostFocus="VornameTextBox_LostFocus" Margin="0,0,0,10" />

      <Grid Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="10" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <Label Content="Dienstbezeichnung" />
          <TextBox Text="{Binding Dienstbez, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <Label Content="Kürzel" />
          <TextBox Text="{Binding Kuerzel, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
      </Grid>

      <Label Content="eMail" />
      <TextBox Text="{Binding Mail, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

      <Label Content="Windowsname" />
      <TextBox Text="{Binding Windowsname, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

      <GroupBox Header="Geschlecht" HorizontalAlignment="Left" Width="120" Margin="0,0,0,10">
        <StackPanel>
          <RadioButton GroupName="Geschlecht" Content="männlich" IsChecked="{Binding IsMaennlich}" />
          <RadioButton GroupName="Geschlecht" Content="weiblich" IsChecked="{Binding IsWeiblich}" />
        </StackPanel>
      </GroupBox>

      <ListBox ItemsSource="{Binding RollenItems}" IsEnabled="{Binding IsRollenListEnabled}" Height="130">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <CheckBox Content="{Binding Bezeichnung}" IsChecked="{Binding IsChecked}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </StackPanel>

    <Button Grid.Row="1" Grid.Column="1" Width="40" Height="40" HorizontalAlignment="Left" Margin="0,10,0,0"
            Command="{Binding SaveCommand}">
      <Image Source="{StaticResource IconSave}" Width="24" Height="24" />
    </Button>
  </Grid>
</Window>
